    "@fontsource/dm-serif-display": "^5.2.6",
    "@fontsource/inter": "^5.2.6",
    "@fontsource/lora": "^5.2.6",
    "@fontsource/montserrat": "^5.2.6",
    "@fontsource/playfair-display": "^5.2.6",
    "@fontsource/poppins": "^5.2.6",
    "@fontsource/space-grotesk": "^5.2.6",
    "dictionary-fr": "^3.0.0",
    "fflate": "^0.8.2",
    "nspell": "^2.1.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
