{
  "name": "studio-pub-systeme-io",
  "version": "1.0.0",
  "private": true,
  "description": "Système de production publicitaire vidéo (TikTok / Instagram Reels) pour Systeme.io : script, voix, séquences Pexels, montage Remotion, contrôle qualité, publication via Metricool, statistiques.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "studio": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "remotion:studio": "remotion studio remotion/index.ts",
    "test:render": "tsx scripts/synthetic-run.ts",
    "voice:setup": "bash scripts/setup-voice.sh"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/captions": "^4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/install-whisper-cpp": "^4.0.541",
    "@remotion/noise": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "tsx": "4.23.15",
    "undici": "7.30.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
